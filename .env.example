# ==============================================================================
# PropTech Environment Variables Template
# DO NOT COMMIT ACTUAL .env WITH PRODUCTION CREDENTIALS
# ==============================================================================

# Core Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate via: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=change-this-to-a-very-long-and-secure-random-string-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (PostgreSQL 16)
DB_NAME=proptech_db
DB_USER=proptech_user
DB_PASSWORD=proptech_secure_password_replace_in_prod
DB_HOST=127.0.0.1
DB_PORT=5432

# Security & Session
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Rate Limiting & Throttling
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME_MINUTES=15

# Error Tracking & Monitoring
SENTRY_DSN=

# Email Verification & Notifications
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@sengran.com

# Media & Storage
INTERNAL_MEDIA_PROTECTED=True
MEDIA_ROOT_PATH=/app/media
# Host folder path for storing uploaded media on external HDD / mount point
MEDIA_STORAGE_PATH=/mnt/hdd_backup/sengranUploads

# ------------------------------------------------------------------------------
# SEO / AEO (canonical URLs, structured data, search console verification)
# ------------------------------------------------------------------------------
# Absolute public origin WITHOUT a trailing slash. Every canonical tag, hreflang link,
# sitemap entry and JSON-LD @id derives from this value — pointing it at the wrong host
# (e.g. www. vs non-www, or an IP) splits ranking signals across duplicate URLs.
SITE_URL=https://www.xn--72ch2atb1d4a4f1fudfc.com
SITE_NAME=เซ้งร้านด่วน.com
# Google Search Console → Settings → Ownership verification → HTML tag (content value only)
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Verify site → Meta tag (content value only)
BING_SITE_VERIFICATION=

