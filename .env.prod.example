# ==============================================================================
# PropTech Production Environment Template (.env.prod)
# Copy this file to .env.prod on your production host and populate real secrets.
# NEVER commit the actual .env.prod file to Git!
# ==============================================================================

# Core Settings
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate securely via: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=change-this-to-a-very-long-and-secure-random-string-at-least-50-chars

# Canonical Public URL (Used for sitemap.xml, schema.org, robots.txt, OpenGraph)
SITE_URL=https://sengranduan.com

# Domain & Reverse Proxy
ALLOWED_HOSTS=sengranduan.com,www.sengranduan.com,localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=https://sengranduan.com,https://www.sengranduan.com

# Database Configuration (PostgreSQL 16 in Docker network)
DB_NAME=proptech_db
DB_USER=proptech_user
DB_PASSWORD=generate_strong_unique_db_password_here
DB_HOST=db
DB_PORT=5432

# Security & HSTS
# Start with safe values (3600s, preload=False) on a new domain to avoid locking out users.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Rate Limiting & Brute-force Defense
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME_MINUTES=15

# Cloudflare Tunnel Token (from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=

# Error Tracking & Monitoring (Sentry)
SENTRY_DSN=

# Email Verification & Notifications (Hostinger / Custom SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=sengranduan@tchhi.online
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=เซ้งร้านด่วน.com <sengranduan@tchhi.online>
EMAIL_TIMEOUT=10

# Bank Transfer & PromptPay Configuration
BANK_NAME=ธนาคารกสิกรไทย (KBANK)
BANK_ACCOUNT_NO=054-1-27630-0
BANK_ACCOUNT_NAME=ดวงฤทัย ช้างน้อย
BANK_CODE=KBANK
PROMPTPAY_TARGET=0541276300
VIP_MONTHLY_PRICE_THB=1000.00

# EasySlip Slip Verification Gateway (API v2)
EASYSLIP_API_KEY=
EASYSLIP_API_URL=https://api.easyslip.com/v2

# Telegram Bot Instant Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
